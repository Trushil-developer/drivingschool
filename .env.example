DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=mypass
DB_NAME=drivingschool
PORT=3000

# Required for OTP verification emails and the automatic welcome/credentials email sent after registration
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_KEY=
AWS_SES_REGION=ap-south-1

# Required for push notifications (clock-in/out reminders, trip-start reminders,
# new-booking alerts, pre-lesson customer reminders). Path to the Firebase
# service-account JSON downloaded from Firebase Console > Project Settings >
# Service Accounts > Generate new private key. Keep this file out of git.
FIREBASE_SERVICE_ACCOUNT_PATH=
